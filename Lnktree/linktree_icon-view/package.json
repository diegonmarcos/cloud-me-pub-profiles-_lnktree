{
  "name": "linktree-icon-view",
  "version": "1.0.0",
  "description": "Linktree Icon View - cloud-superapp launcher layout over the linktree link data",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "build:css": "sass src/scss/main.scss style.css --style=compressed --no-source-map",
    "build:ts": "tsc",
    "dev:css": "sass src/scss/main.scss src/style.css --style=expanded --source-map --watch",
    "dev:bundle": "esbuild src/typescript/main.ts --bundle --outfile=src/script.js --format=iife --target=es2020 --sourcemap --watch",
    "typecheck": "tsc --noEmit"
  },
  "author": "Diego Nepomuceno Marcos",
  "license": "ISC",
  "devDependencies": {
    "esbuild": "^0.20.2",
    "sass": "^1.77.0",
    "typescript": "^5.9.3"
  }
}
