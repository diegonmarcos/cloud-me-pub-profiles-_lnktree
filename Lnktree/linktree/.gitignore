# are consolidated inputs, not outputs)
src/data/data-banners.json.js
src/data/data-gh-pages.json.js
src/data/data-linktree-mindmap.json.js
src/data/data-linktree.json.js
src/data/data-personal-profiles.json.js
src/data/data-professional-profiles.json.js
src/data/data-projects.json.js
src/data/data-areas.json.js
