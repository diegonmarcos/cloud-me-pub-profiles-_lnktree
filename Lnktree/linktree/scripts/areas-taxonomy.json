  "folders": {
    "_doc": "How a repo's folder tree (registry 0_repo-folders-tree) becomes applications. Skipped: names matching `skip`. Containers (`containers`) are transparent: their children are the repo's apps. A folder WITHOUT a prefix, named with a capital letter, that holds kept sub-folders is a group: one column (its name), its sub-folders the apps (e.g. Game-Production -> Godot, Unity). Any other top-level folder is one app; its `prefix_` (e.g. infra-api_, user-ai_, da_) is dropped from the label and, when present, names its column. Apps with no group or prefix go in a column named after the repo. A repo with no kept folder is itself one app. Prefixes of one or two characters (a_, ca_, C2_) only shorten the label; their apps go in the repo column. A repo that is a single app is listed in a column named after its family. Matching is case-insensitive.",
    "skip": "^(\\.|_|\\d|[a-z]0_|z_|tests?$|test_|dist|docs?$|scripts?$|licenses?$|build$|vendor$|node_modules$|data$|configs?$|nix$|lib$|libs$|assets$|public$|web$|src-tauri$|src_|tmp$|inc$|includes?$|obj$|log$|results$|.*_{4,})",
    "containers": [
      "src",
      "apps",
      "b_Projects",
      "b_projects",
      "packages",
      "modules",
      "Lnktree"
    ],
    "prefix": "^([a-z]{1,5}(?:-[a-z]{1,5})?|[A-Z]\\d|[a-z]-[A-Z][a-z]{2})_+(?=[A-Za-z0-9])",
    "prefix_columns": {
      "_doc": "Column header per folder prefix (lower-case key); a prefix not listed uses its own name upper-cased.",
